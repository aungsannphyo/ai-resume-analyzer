# Groq API Configuration
# Get your API key from Groq Console: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Default Model Selection (Options: instant | versatile)
# Default is "versatile"
MODEL_TYPE=versatile

# Groq Production Model IDs (from https://console.groq.com/docs/models)
# Fast & lightweight (GPT OSS 20B - 1000 tokens/sec)
GROQ_MODEL_INSTANT=openai/gpt-oss-20b

# Powerful & deep reasoning (GPT OSS 120B - 500 tokens/sec)
GROQ_MODEL_VERSATILE=openai/gpt-oss-120b
